
# Public site URL (used for Stripe return URLs and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (create a NEW project: PRD section 15.1)
NEXT_PUBLIC_SUPABASE_URL=---
NEXT_PUBLIC_SUPABASE_ANON_KEY=---

# SERVER ONLY. Bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=---

# Stripe TEST mode only
STRIPE_SECRET_KEY=---

STRIPE_WEBHOOK_SECRET=---
# Optional: pre-created Stripe price ids. If empty, Checkout uses inline price_data from the plans table.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# AI provider (optional). Leave AI_PROVIDER=none for the built-in deterministic fallback.
# Supported: none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_MS=8000

# Shared secret for the scheduled revenue-recognition endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=----

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=DemoAdmin@2026
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=